<odoo>

  <!-- action para invocar view de opciones de impresora -->
  <record id="action_pos_options" model="ir.actions.act_window">
    <field name="name">Opciones de Impresora Fiscal</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">pos.printer.options</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>

    <field name="context">{
      'search_default_config_id': [active_id],
      'default_config_id': active_id}
    </field>
  </record>

  <!-- agrega opción en menú del kanban -->
  <record id="3mit_print_server_options" model="ir.ui.view">
    <field name="name">pos.config.kanban.view</field>
    <field name="model">pos.config</field>
    <field name="inherit_id" ref="point_of_sale.view_pos_config_kanban" />
    <field name="arch" type="xml">
      <xpath expr="//button[contains(@class, 'btn-primary')]" position="before">
        <div class="mb-2 d-block">
          <a type="action" name="%(action_pos_options)d" class="btn btn-sm btn-outline-primary w-100 text-start fw-bold py-1 px-2">
            <i class="fa fa-print me-1"></i> Opciones de Impresora
          </a>
        </div>
      </xpath>
    </field>
  </record>

  <!-- caja de opciones -->
  <record id="options_form" model="ir.ui.view">
    <field name="name">Opciones de Impresora</field>
    <field name="model">pos.printer.options</field>
    <field name="arch" type="xml">
      
      <form id="printer_options" js_class="pos_printer_options" string="Opciones de Impresora Fiscal">
        <field name="printer_host" invisible="1" />
        <sheet class="p-3 pos-printer-options-sheet">
          <div class="pos-printer-container">
            
            <!-- Tarjeta 1: Reportes Diarios (X y Z) -->
            <div class="card mb-3 shadow-sm border-0 bg-view-card">
              <div class="card-header bg-transparent border-bottom d-flex align-items-center py-2 px-3">
                <i class="fa fa-tachometer text-primary fs-5 me-2"></i>
                <h5 class="mb-0 fw-bold text-uppercase fs-6">Reportes Diarios (X / Z)</h5>
              </div>
              <div class="card-body p-3">
                <div class="row g-3">
                  
                  <!-- Subsección Reporte X -->
                  <div class="col-md-6 border-end-md pb-3 pb-md-0">
                    <div class="d-flex flex-column h-100 justify-content-between">
                      <div>
                        <div class="d-flex align-items-center mb-2">
                          <span class="badge bg-primary-subtle text-primary me-2 px-2 py-1">REPORTE X</span>
                          <strong class="fs-6">Cierre Parcial</strong>
                        </div>
                        <p class="text-muted small mb-3">Imprime una lectura de ventas parcial sin cortar ni cerrar la memoria fiscal diaria.</p>
                      </div>
                      <div>
                        <button id="reporteX" type="button" class="btn btn-outline-primary btn-sm w-100 fw-bold">
                          <i class="fa fa-print me-1"></i> Imprimir Reporte X
                        </button>
                      </div>
                    </div>
                  </div>

                  <!-- Subsección Reporte Z -->
                  <div class="col-md-6 pt-3 pt-md-0">
                    <div class="d-flex flex-column h-100 justify-content-between">
                      <div>
                        <div class="d-flex align-items-center mb-2">
                          <span class="badge bg-danger-subtle text-danger me-2 px-2 py-1">REPORTE Z</span>
                          <strong class="fs-6">Cierre Fiscal</strong>
                        </div>
                        <div class="mb-2">
                          <field name="reportZ_options" string="Filtro de Reporte Z" widget="selection" class="form-select-sm" />
                        </div>
                        
                        <div invisible="reportZ_options != 'diario'" class="mb-2">
                          <p class="text-muted small mb-0">Imprime el cierre fiscal Z correspondiente a la jornada diaria actual.</p>
                        </div>

                        <div invisible="reportZ_options != 'numero'" class="mb-2">
                          <group class="m-0 border-0 p-0">
                            <field name="numZInicio" placeholder="Ej. 1" />
                            <field name="numZFin" placeholder="Ej. 100" />
                          </group>
                        </div>

                        <div invisible="reportZ_options != 'fecha'" class="mb-2">
                          <group class="m-0 border-0 p-0">
                            <field name="fechaZInicio" />
                            <field name="fechaZFin" />
                          </group>
                        </div>
                      </div>

                      <div class="mt-2">
                        <button id="reporteZ" invisible="reportZ_options != 'diario'" type="button" class="btn btn-danger btn-sm w-100 fw-bold">
                          <i class="fa fa-file-text-o me-1"></i> Imprimir Reporte Z
                        </button>
                        <button id="reporteZporNumero" invisible="reportZ_options != 'numero'" type="button" class="btn btn-danger btn-sm w-100 fw-bold">
                          <i class="fa fa-file-text-o me-1"></i> Imprimir Z por Número
                        </button>
                        <button id="reporteZporFecha" invisible="reportZ_options != 'fecha'" type="button" class="btn btn-danger btn-sm w-100 fw-bold">
                          <i class="fa fa-file-text-o me-1"></i> Imprimir Z por Fecha
                        </button>
                      </div>
                    </div>
                  </div>

                </div>
              </div>
            </div>

            <!-- Tarjeta 2: Memoria de Auditoría -->
            <div class="card mb-3 shadow-sm border-0 bg-view-card">
              <div class="card-header bg-transparent border-bottom d-flex align-items-center py-2 px-3">
                <i class="fa fa-history text-warning fs-5 me-2"></i>
                <h5 class="mb-0 fw-bold text-uppercase fs-6">Memoria de Auditoría</h5>
              </div>
              <div class="card-body p-3">
                <p class="text-muted small mb-2">Reimpresión en lote de documentos fiscales registrados en la memoria de la impresora.</p>
                <div class="row align-items-center g-3">
                  <div class="col-md-7">
                    <group class="m-0 border-0 p-0">
                      <field name="numFacturaInicio" string="Número Inicial" placeholder="0" />
                      <field name="numFacturaFin" string="Número Final" placeholder="0" />
                    </group>
                  </div>
                  <div class="col-md-5 d-flex flex-column gap-2">
                    <button id="reporteFacturas" type="button" class="btn btn-primary btn-sm fw-bold">
                      <i class="fa fa-file-text me-1"></i> Imprimir Facturas
                    </button>
                    <button id="reporteNC" type="button" class="btn btn-secondary btn-sm fw-bold">
                      <i class="fa fa-undo me-1"></i> Imprimir Notas de Crédito
                    </button>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </sheet>
        <footer class="d-flex justify-content-end p-2 border-top">
          <button string="Cancelar" class="btn btn-secondary px-4" special="cancel" />
        </footer>
      </form>

    </field>
  </record>

</odoo>