<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="PartnerDetailsEdit" t-inherit="point_of_sale.PartnerDetailsEdit" t-inherit-mode="extension" owl="1">

        <xpath expr="//input[@class='detail partner-name']" position="replace">
         <div class="partner-details-left">
            <input class="detail partner-name" name="name" t-model="changes.name" placeholder="NOMBRE Y APELLIDO(MAYUS)" t-on-change="captureChange"/>
         </div>
        </xpath>
        <xpath expr="//div[@class='partner-details-box clearfix']" position="replace">
            <div class="partner-details-left">

                <xpath expr="//div[@class='partner-details-left']" position="before">
                    <div class="partner-detail">
                        <span class="label">Tipo de Identificación</span>
                        <select class="detail id-type" name="id_type" t-model="changes.id_type" t-on-change="captureChange">
                            <option value="J">J</option>
                            <option value="V">V</option>
                            <option value="G">G</option>
                            <option value="P">P</option>
                            <option value="C">C</option>
                            <option value="E">E</option>
                        </select>
                    </div>
                </xpath>

                <div class="partner-detail">
                    <span class="label">C.I/R.I.F</span>
                    <input class="detail vat" name="identification_id" placeholder=" 12345678" t-model="changes.identification_id" t-on-change="captureChange" />
                </div>

                <div class="partner-detail">
                    <span class="label">Phone</span>
                    <input class="detail" name="phone" type="tel" placeholder=" 04121111111" t-model="changes.phone" t-on-change="captureChange" />
                </div>

                <div class="partner-detail">
                    <span class="label">Dirección</span>
                    <input class="detail" name="street" t-model="changes.street" t-on-change="captureChange" />
                </div>

                <div class="partner-detail">
                    <span class="label">Email</span>
                    <input class="detail" name="email" t-model="changes.email" t-on-change="captureChange" />
                </div>

                <!-- Nuevo campo: Etiquetas (temporal: se guarda en changes.category_names para evitar error en category_id) -->
                <div class="partner-detail">
                    <span class="label">Etiquetas</span>
                    <input class="detail" name="category_names" t-model="changes.category_names" placeholder="etiqueta1,etiqueta2" t-on-change="captureChange" />
                </div>
            </div>
        </xpath>
    </t>
</templates>