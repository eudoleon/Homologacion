<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_credit" model="ir.ui.view">
        <field name="name">res.partner.form.credit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']" position="inside">
                <group string="Crédito y Facturación" name="credit_management">
                    <field name="activate_credit"/>
                    <field name="credit_limit_custom"/>
                    <field name="total_invoiced_amount" readonly="1"/>
                    <field name="is_credit_restricted"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
