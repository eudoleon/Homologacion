<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="Chrome" t-inherit="point_of_sale.Chrome" t-inherit-mode="extension">
        <xpath expr="//CashierName" position="before">
            <div class="currency-rate-info" style="margin-right: 10px; font-size: 14px; color: white;">
                <span style="margin-right: 10px;">Tasa del dia: </span>
                <span t-esc="env.pos.format_currency(1 / env.pos.config.show_currency_rate)"/>
            </div>
        </xpath>
    </t>
</templates>
