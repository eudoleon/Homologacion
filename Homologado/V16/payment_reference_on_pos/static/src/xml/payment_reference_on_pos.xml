<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="PaymentScreenPaymentLines" t-inherit="point_of_sale.PaymentScreenPaymentLines" t-inherit-mode="extension" owl="1">
        <xpath expr="//t[@t-if='line.selected']//div[hasclass('payment-amount')]" position="before">
            <t t-if='env.pos.config.is_allow_payment_reference'>
                <div class="payment-reference">
                    <span class='payment-info-button pull-right' t-att-data-cid='line.cid'
                        t-on-click="() => this.trigger('update-payment-reference', { cid: line.cid })">
                    <i class='fa fa-edit'> Reference</i>
                </span>
                </div>
            </t>
        </xpath>
        <xpath expr="//t[@t-else='']//div[hasclass('payment-amount')]" position="before">
            <div class="payment-reference">
                <span class='payment-info-button pull-right' t-att-data-cid='line.cid'
                    t-on-click="() => this.trigger('update-payment-reference', { cid: line.cid })">
                    <i class='fa fa-edit'> Reference</i>
                </span>
            </div>
        </xpath>
    </t>

    <t t-name="PaymentReferencePopup"  owl="1">
        <div role="dialog" class="modal-dialog">
            <div class="popup popup-text PaymentReferencePopup">
                <header class="title">                    
                    <t t-esc="props.title" />
                </header>
                <main class="body col-lg-4 col-md-6 col-sm-12">
                    <div class="attribute">
                        <textarea t-model="state.inputValue" t-ref="input"></textarea>
                    </div>
                </main>
                <footer class="footer footer_pos_dialog">
                    <div class="button confirm" t-on-click="confirm">
                        <t t-esc="props.confirmText" />
                    </div>
                    <div class="button cancel" t-on-click="cancel">
                        <t t-esc="props.cancelText" />
                    </div>
                </footer>
            </div>
        </div>
    </t>

</templates>