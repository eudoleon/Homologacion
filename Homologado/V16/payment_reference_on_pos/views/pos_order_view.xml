<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pos_form_payment_reference" model="ir.ui.view">
        <field name="name">pos.payment.pos.order.form</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page/field[@name='payment_ids']/tree/field[@name='payment_method_id']" position="after">
                <field name="payment_reference" invisible="0"/>                
            </xpath>
        </field>
    </record>
</odoo>