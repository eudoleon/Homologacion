<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_pos_reference" model="ir.ui.view">
        <field name="name">res.config.form.inherit.pos.reference</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <div id="pos_accounting_section" position="after">
                <h2>Payment Reference</h2>
                <div class="row mt16 o_settings_container" id='pos_payment_reference'>
                    <div class="col-12 col-lg-6 o_setting_box" name="pos_payment_reference_div">
                        <div class="o_setting_left_pane">
                            <field name="is_allow_payment_reference"/>
                        </div>   
                        <div class="o_setting_right_pane">
                            <label for="is_allow_payment_reference" string="POS Payment Reference"/>
                            <div class="text-muted">
                                If enabled, the cashier will be able to add payment references on each POS payment line.
                            </div>                            
                        </div>                                              
                    </div>
                </div>
            </div>
        </field>
    </record>
</odoo>