<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="TicketScreen"
        t-inherit="point_of_sale.TicketScreen"
        t-inherit-mode="extension"
        owl="1"
    >
        <!-- Modificación para el botón ManyOrder (ya existente) -->
        <xpath
            expr="//div[hasclass('ticket-screen')]//button[hasclass('highlight')]"
            position="attributes"
        >
            <attribute name="t-att-class">{'disabled-mode': !hasNewOrdersControlRights}</attribute>
            <attribute name="t-att-disabled">!hasNewOrdersControlRights</attribute>
        </xpath>
        <!-- Nueva modificación para el botón Delete Order -->
        <xpath
            expr="//div[hasclass('ticket-screen')]//button[contains(@class, 'delete-order')]"
            position="attributes"
        >
            <attribute name="t-att-class">{'disabled-mode': !hasDeleteOrderRights}</attribute>
            <attribute name="t-att-disabled">!hasDeleteOrderRights</attribute>
        </xpath>
    </t>
</templates>
