<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_cashea_debt_type" model="ir.ui.view">
        <field name="name">account.move.form.cashea.debt.type</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='journal_div']" position="after">
                <field name="tipo_de_deuda" attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'out_receipt', 'in_invoice', 'in_refund', 'in_receipt'))]}"/>
            </xpath>
        </field>
    </record>
</odoo>