<odoo>
	<record id="wk_custom_discount_view_pos_config_settings_form" model="ir.ui.view">
		<field name="name">res.config.settings.custom.view</field>
		<field name="model">res.config.settings</field>
		<field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
		<field name="arch" type="xml">
			<xpath expr="//div[@id='pos_accounting_section']" position="after">
				<h2>Discounts</h2>
				<div class="row mt16 o_settings_container">
					<div class="col-xs-12 col-md-6 o_setting_box" title="Choose discount from the given list that you wishes to make available in current POS Session.">
						<div class="o_setting_right_pane">
							<label for="pos_discount_ids" string="Select Discounts"/>
							<div class="text-muted">
                                Choose discounts from the given list for current POS
							</div>
							<div class="content-group">
								<div class="mt16">
									<field name="pos_discount_ids" widget="many2many_tags"/>
								</div>
							</div>
						</div>
					</div>
					<div class="col-xs-12 col-md-6 o_setting_box" title="Only users with Manager access rights for PoS app can modify the product prices on orders.">
						<div class="o_setting_left_pane">
							<field name="pos_allow_custom_discount"/>
						</div>
						<div class="o_setting_right_pane">
							<label for="pos_allow_custom_discount" string="Allow Customize Discount"/>
							<div class="text-muted">
								Check here to allow customize discount in current POS 
							</div>
						</div>
					</div>
					<div class="col-xs-12 col-md-6 o_setting_box" attrs="{'invisible':[('pos_allow_custom_discount','=',False)]}" title="Only users with Manager access rights for PoS app can modify the product prices on orders.">
						<div class="o_setting_left_pane">
							<field name="pos_allow_security_pin"/>
						</div>
						<div class="o_setting_right_pane">
							<label for="pos_allow_security_pin" string="Allow Security Pin"/>
							<div class="text-muted">
								Check here to ask pin whenever seller click on custom discount button
							</div>
						</div>
					</div>
				</div>
			</xpath>
		</field>
	</record>
</odoo>
