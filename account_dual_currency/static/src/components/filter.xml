<?xml version="1.0" encoding="UTF-8" ?>
<template>
    <t t-name="DualCurrencyFilters"
       t-inherit="account_reports.AccountReportFiltersCustomizable"  t-inherit-mode="extension" owl="1" >
       <xpath expr="//div[@id='filter_extra_options']/.." position="inside">
            <div id="search_template_currency_dif" class="ms-1">
                <Dropdown>
                    <button class="btn btn-secondary dropdown-toggle" type="button">
                        <i class="fa fa-money me-1"/>
                        En
                        <span class="ms-1">
                            <t t-esc="controller.options.currency_dif"/>
                        </span>
                    </button>
                    <t t-set-slot="content">
                    <DropdownItem
                            class="{ 'filter_date_single_today_hook': true, 'selected': (controller.options.currency_dif == controller.options.currency_id_company_name) }"
                            onSelected="() => controller.updateOption('currency_dif', controller.options.currency_id_company_name, true)">
                        Moneda principal:
                        <t t-esc="controller.options.currency_id_company_name"/>
                    </DropdownItem>
                    <DropdownItem
                            class="{ 'filter_date_single_last_month_hook': true, 'selected': (controller.options.currency_dif == controller.options.currency_id_dif_name) }"
                            onSelected="() => controller.updateOption('currency_dif', controller.options.currency_id_dif_name, true)">
                        Moneda secundaria:
                        <t t-esc="controller.options.currency_id_dif_name"/>
                    </DropdownItem>
                    </t>
                </Dropdown>
            </div>
        </xpath>
    </t>

    <t t-name="DualCurrencyFiltersAged"
       t-inherit="account_reports.AgedPartnerBalanceFilters"  t-inherit-mode="extension" owl="1" >
       <xpath expr="//div[@id='filter_extra_options']/.." position="inside">
            <div id="search_template_currency_dif_aged" class="ms-1">
                <Dropdown>
                    <button class="btn btn-secondary dropdown-toggle" type="button">
                        <i class="fa fa-money me-1"/>
                        En
                        <span class="ms-1">
                            <t t-esc="controller.options.currency_dif"/>
                        </span>
                    </button>
                    <t t-set-slot="content">
                    <DropdownItem
                            class="{ 'filter_date_single_today_hook': true, 'selected': (controller.options.currency_dif == controller.options.currency_id_company_name) }"
                            onSelected="() => controller.updateOption('currency_dif', controller.options.currency_id_company_name, true)">
                        Moneda principal:
                        <t t-esc="controller.options.currency_id_company_name"/>
                    </DropdownItem>
                    <DropdownItem
                            class="{ 'filter_date_single_last_month_hook': true, 'selected': (controller.options.currency_dif == controller.options.currency_id_dif_name) }"
                            onSelected="() => controller.updateOption('currency_dif', controller.options.currency_id_dif_name, true)">
                        Moneda secundaria:
                        <t t-esc="controller.options.currency_id_dif_name"/>
                    </DropdownItem>
                    </t>
                </Dropdown>
            </div>
        </xpath>
    </t>
</template>