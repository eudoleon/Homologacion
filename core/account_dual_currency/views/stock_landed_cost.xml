<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id='view_stock_landed_cost_form' model='ir.ui.view'>
        <field name="name">stock.landed.cost.form</field>
        <field name="model">stock.landed.cost</field>
        <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_form" />
        <field name="arch" type="xml">
            <!-- Mantener el subtotal footer -->
            <xpath expr="//group[@class='oe_subtotal_footer']" position="replace">
                <group class="oe_subtotal_footer">
                    <field name="currency_id" invisible="1"/>
                    <field name="amount_total"/>
                    <button colspan="2" name="compute_landed_cost" string="Compute" type="object" class="float-end btn-secondary" invisible="state != 'draft'"/>
                </group>
            </xpath>
            
            <!-- Agregar campo currency_id después de account_journal_id -->
            <xpath expr="//field[@name='account_journal_id']" position="after">
                <field name="currency_id" readonly="state == 'done'" groups="base.group_multi_currency"/>
            </xpath>
            
            <!-- Agregar campos USD en la lista de cost_lines -->
            <xpath expr="//field[@name='cost_lines']//list//field[@name='price_unit']" position="before">
                <field name="tax_today" optional="show"/>
                <field name="company_currency_id" column_invisible="1"/>
                <field name="currency_price_unit" optional="show"/>
            </xpath>
            
            <xpath expr="//field[@name='cost_lines']//list//field[@name='price_unit']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            
            <!-- Agregar página de asientos contables -->
            <xpath expr="//page[@name='valuation_adjustments']" position="after">
                <page string="Asientos Contables" name="page_move_ids">
                    <field name="move_ids" nolabel="1"/>
                </page>
            </xpath>
            
            <!-- Agregar campos USD en valuation_adjustment_lines -->
            <xpath expr="//field[@name='valuation_adjustment_lines']//list//field[@name='former_cost']" position="after">
                <field name="currency_id_dif" column_invisible="1"/>
                <field name="former_cost_usd" optional="show"/>
            </xpath>
            
            <xpath expr="//field[@name='valuation_adjustment_lines']//list//field[@name='final_cost']" position="after">
                <field name="final_cost_usd" optional="show"/>
            </xpath>
            
            <xpath expr="//field[@name='valuation_adjustment_lines']//list//field[@name='additional_landed_cost']" position="after">
                <field name="additional_landed_cost_usd" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
