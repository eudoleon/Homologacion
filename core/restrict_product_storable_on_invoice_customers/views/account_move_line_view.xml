<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_filter_services" model="ir.ui.view">
        <field name="name">account.move.form.filter.services</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='product_id']" position="attributes">
                <attribute name="domain">[('type', '=', 'service')]</attribute>
            </xpath>
        </field>
    </record>
</odoo>