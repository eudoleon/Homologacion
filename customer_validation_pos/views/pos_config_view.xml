<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_inherit_cust_validation" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.customer.validation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_accounting_section']" position="after">
                <block title="POS Customer Validation" id="pos_customer_validation_section">
                    <setting string="Require Name" help="Require customer name when saving customer in POS">
                        <field name="required_name"/>
                    </setting>
                    <setting string="Unique Name" help="Prevent duplicate customer name when saving customer in POS">
                        <field name="unique_name"/>
                    </setting>
                    <setting string="Require Phone" help="Require phone number (11 digits) when saving customer in POS">
                        <field name="required_phone"/>
                    </setting>
                    <setting string="Unique Phone" help="Prevent duplicate phone number when saving customer in POS">
                        <field name="unique_phone"/>
                    </setting>
                    <setting string="Require Email" help="Require email address when saving customer in POS">
                        <field name="required_email"/>
                    </setting>
                    <setting string="Unique Email" help="Prevent duplicate email address when saving customer in POS">
                        <field name="unique_email"/>
                    </setting>
                    <setting string="Require VAT / RIF" help="Require Tax ID (RIF / C.I) when saving customer in POS">
                        <field name="required_vat"/>
                    </setting>
                    <setting string="Unique VAT / RIF" help="Prevent duplicate Tax ID (RIF / C.I) when saving customer in POS">
                        <field name="unique_vat"/>
                    </setting>
                    <setting string="Require Street" help="Require street address when saving customer in POS">
                        <field name="required_street"/>
                    </setting>
                    <setting string="Unique Street" help="Prevent duplicate street address when saving customer in POS">
                        <field name="unique_street"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>