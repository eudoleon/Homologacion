<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="hide_pos_product_info.SaleOrderList" t-inherit="pos_sale.SaleOrderList" t-inherit-mode="extension" owl="1">
        <xpath expr="//t[@t-foreach='props.orders']" position="attributes">
            <attribute name="t-foreach">
                props.orders.filter(order =&gt;
                    order.state === 'done' || !order.pos_order_line_ids
                )
            </attribute>
        </xpath>
    </t>
</templates>