<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='point_of_sale']" position="inside">
                <block title="Ocultar Información en Punto de Venta">
                    <setting help="Oculta los botones de Información de Producto, Devoluciones, Tarifa y Comensales en el POS.">
                        <field name="pos_hide_product_info" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>