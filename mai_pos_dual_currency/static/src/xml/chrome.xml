<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="mai_pos_dual_currency.Navbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-leftheader')]/div" position="inside">
            <t t-set="pos" t-value="this.pos || this.env.pos || (this.env.services.pos &amp;&amp; this.env.services.pos.pos)"/>
            <div t-if="pos and pos.config and pos.config.show_dual_currency" class="currency-rate-info d-flex align-items-center ms-2 px-3 py-1 rounded-pill">
                <i class="fa fa-usd me-1 rate-icon" aria-hidden="true"/>
                <span class="rate-label me-1">Tasa del día:</span>
                <t t-set="rate_value" t-value="pos.config.show_currency_rate ? (1 / pos.config.show_currency_rate) : 0"/>
                <span class="rate-value" t-if="pos.config.show_currency_rate" t-esc="env.utils.formatCurrency(rate_value, false)"/>
            </div>
        </xpath>
    </t>
</templates>
