<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pestaña de Pagos dentro del Formulario de Pedido (pos.order) -->
    <record id="view_pos_pos_form_payment_reference" model="ir.ui.view">
        <field name="name">pos.order.form.payment.reference</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_ids']//field[@name='payment_method_id']" position="after">
                <field name="payment_reference" string="Referencia de Pago"/>
            </xpath>
        </field>
    </record>

    <!-- Vista de lista independiente de pos.payment -->
    <record id="view_pos_payment_tree_payment_reference" model="ir.ui.view">
        <field name="name">pos.payment.tree.payment.reference</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_method_id']" position="after">
                <field name="payment_reference" string="Referencia de Pago" invisible="0"/>                
            </xpath>
        </field>
    </record>
</odoo>