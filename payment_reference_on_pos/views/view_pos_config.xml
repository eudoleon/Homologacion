<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_pos_reference" model="ir.ui.view">
        <field name="name">res.config.form.inherit.pos.reference</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_accounting_section']" position="inside">
                <setting string="POS Payment Reference" help="If enabled, the cashier will be able to add payment references on each POS payment line.">
                    <field name="is_allow_payment_reference"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>