<odoo>
	<record id="wk_custom_discount_view_pos_config_settings_form" model="ir.ui.view">
		<field name="name">res.config.settings.custom.view</field>
		<field name="model">res.config.settings</field>
		<field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
		<field name="arch" type="xml">
			<xpath expr="//app[@name='point_of_sale']" position="inside">
				<block title="Descuentos Personalizados TPV">
					<setting string="Descuentos del POS" help="Elija los descuentos que desea que estén disponibles en la sesión actual del TPV.">
						<field name="pos_discount_ids" widget="many2many_tags"/>
					</setting>
					<setting string="Permitir Descuento Personalizado" help="Marque para permitir la personalización de descuentos en la sesión actual del TPV.">
						<field name="pos_allow_custom_discount"/>
					</setting>
					<setting string="PIN de Seguridad para Descuentos" help="Marque para pedir un código PIN de seguridad cuando el cajero presione el botón de descuento personalizado." invisible="not pos_allow_custom_discount">
						<field name="pos_allow_security_pin"/>
					</setting>
				</block>
			</xpath>
		</field>
	</record>
</odoo>
