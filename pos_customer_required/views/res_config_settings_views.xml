<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_pos_customer_required" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.customer.required</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='point_of_sale']" position="inside">
                <block title="Require Customer Settings">
                    <setting help="Require customer for orders in this point of sale">
                        <field name="pos_require_customer" widget="radio"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
