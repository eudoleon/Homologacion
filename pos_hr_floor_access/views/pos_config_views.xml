<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_pos_floor_access" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.floor.access</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='point_of_sale']" position="inside">
                <block title="Restricción de Pisos por Empleado" id="pos_hr_floor_access_block">
                    <setting string="Restringir Pisos por Empleado" help="Filtra los pisos visibles y accesibles en el TPV para que cada empleado solo opere en los pisos que tiene asignados." id="pos_restrict_floors_by_employee_setting">
                        <field name="pos_restrict_floors_by_employee"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
