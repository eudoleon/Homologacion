<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit_pos_negative_stock" model="ir.ui.view">
        <field name="name">product.template.form.inherit.pos.negative.stock</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='pos']" position="inside">
                <field name="allow_pos_negative_stock"/>
            </xpath>
        </field>
    </record>
</odoo>
