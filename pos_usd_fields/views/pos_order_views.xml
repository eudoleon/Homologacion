<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_pos_order_form_inherit_usd" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.usd</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lines']/list" position="inside">
                <field name="price_unit_usd" widget="float" string="Precio Unitario Ref"/>
                <field name="price_subtotal_usd" widget="float" string="Subtotal sin Imp. Ref"/>
                <field name="price_subtotal_incl_usd" widget="float" string="Subtotal con Imp. Ref"/>
            </xpath>
        </field>
    </record>
</odoo>
