<odoo>
    <record id="view_company_form_vat_retention" model="ir.ui.view">
        <field name="name">res.company.form.vat.retention</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Retención IVA POS">
                    <field name="vat_retention_rate"/>
                    <field name="account_vat_retention_id" string="CUENTA POR PAGAR PROVEEDOR (IVA)"/>
                    <field name="account_payable_retention_id" string="CUENTA IVA RETENIDO"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>